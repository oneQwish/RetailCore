="330" width="140" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Pricing &amp; Promo Logic&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;не меняется&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="745" y="225" width="140" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Order Processing&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;+ команда отмены: снять резерв, статус «отменён»&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2E8B3E&quot;&gt;&lt;b&gt;● Сервис статуса заказа и шлюз API&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF1E0;strokeColor=#2E8B3E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="945" y="322" width="150" height="76" as="geometry"/></mxCell><mxCell id="c30" value="Payment Orchestration&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;+ события оплаты, возврат по команде&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#E8710A&quot;&gt;&lt;b&gt;● Поток событий заказа&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF1E0;strokeColor=#E8710A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1150" y="225" width="140" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Delivery Routing&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;заявки в службы доставки и склады&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1210" y="330" width="150" height="70" as="geometry"/></mxCell><mxCell id="c32" value="Status Management&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;пишет событие в outbox&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#E8710A&quot;&gt;&lt;b&gt;● Поток событий заказа&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF1E0;strokeColor=#E8710A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="945" y="520" width="150" height="70" as="geometry"/></mxCell><mxCell id="c33" value="Async / batch exchange&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;очереди и выгрузки, без изменений&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E8F1FA;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="180" height="80" as="geometry"/></mxCell><mxCell id="c34" value="Уведомления клиенту&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;подписка на поток решается позже&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="745" y="520" width="170" height="80" as="geometry"/></mxCell><mxCell id="c35" value="Сервис статуса заказа&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;сага, таймер оплаты, своя база статуса&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2E8B3E&quot;&gt;&lt;b&gt;● Сервис статуса заказа и шлюз API&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#E6F4E8;strokeColor=#2E8B3E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1440" y="230" width="230" height="90" as="geometry"/></mxCell><mxCell id="c36" value="Брокер событий (Kafka)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;поток событий заказа&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#E8710A&quot;&gt;&lt;b&gt;● Поток событий заказа&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#E8F1FA;strokeColor=#E8710A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1440" y="380" width="230" height="90" as="geometry"/></mxCell><mxCell id="c37" value="Публикатор событий&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;читает outbox, отправляет в брокер&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#E8710A&quot;&gt;&lt;b&gt;● Поток событий заказа&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#E6F4E8;strokeColor=#E8710A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1440" y="530" width="230" height="80" as="geometry"/></mxCell><mxCell id="c38" value="Журнал событий заказа&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;история и причины отклонений&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#2E8B3E&quot;&gt;&lt;b&gt;● Сервис статуса заказа и шлюз API&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#E6F4E8;strokeColor=#2E8B3E;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1710" y="230" width="280" height="80" as="geometry"/></mxCell><mxCell id="c39" value="Хранилище аналитики&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;наполняется из потока&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F77B4&quot;&gt;&lt;b&gt;● Аналитика на потоке событий&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#E6F4E8;strokeColor=#1F77B4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1710" y="350" width="280" height="80" as="geometry"/></mxCell><mxCell id="c40" value="Python-задания и отчёты&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;читают хранилище вместо Oracle&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#1F77B4&quot;&gt;&lt;b&gt;● Аналитика на потоке событий&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF1E0;strokeColor=#1F77B4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1710" y="470" width="280" height="70" as="geometry"/></mxCell><mxCell id="c41" value=".NET: адаптеры партнёров&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;события вместо таблиц, по одному партнёру&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8E5BB5&quot;&gt;&lt;b&gt;● Партнёрские интеграции на событиях&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFF1E0;strokeColor=#8E5BB5;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1710" y="590" width="280" height="90" as="geometry"/></mxCell><mxCell id="c42" value="Процедуры и пакеты с бизнес-логикой&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;не переносим, перечня пока нет&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="750" y="890" width="240" height="90" as="geometry"/></mxCell><mxCell id="c43" value="Таблицы заказов, статусов и истории" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1010" y="890" width="240" height="90" as="geometry"/></mxCell><mxCell id="c44" value="Таблица outbox&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;событие в той же транзакции&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#E8710A&quot;&gt;&lt;b&gt;● Поток событий заказа&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=1;arcSi